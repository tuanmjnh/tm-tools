# ==============================================================================
#
# TM-Tools Application Environment Configuration (.env.example)
#
# Env-key standard (v2, 2026-10-20): every app stores ONLY its own identifiers.
# Satellites never carry tm-hub's id and tm-hub never carries a satellite's id;
# child app ids are managed dynamically in the hub `apps` table by `pnpm seed`.
#
#   tm-hub       -> APP_ID
#   tm-tools     -> NUXT_PUBLIC_HUB_APP_ID  (own app id; X-App-Id sent to hub)
#   tm-trading   -> NUXT_PUBLIC_HUB_APP_ID  (own app id; X-App-Id sent to hub)
#   all three    -> AUTH_JWT_SECRET         (shared JWT signing secret, must
#                  match tm-hub AUTH_JWT_SECRET when AUTH_PROVIDER=hub replaces
#                  the old AUTH_ACCESS_TOKEN_SECRET name)
#   satellites   -> NUXT_PUBLIC_HUB_URL      (hub base URL, canonical name)
#
# Copy this file to .env and fill in values. DO NOT commit .env.
# ==============================================================================

# Application & Ports
# - dev (pnpm dev): http://localhost:4002 (PORT; fleet allocation: hub 4000,
#   trading 4001, tools 4002)
# - Electron prod (pnpm dev:electron / build:electron): APP_PORT=3456 (NITRO_PORT)
PORT=4002
APP_PORT=3456
APP_URL=http://localhost:4002
APP_NAME="TM Tools"

# TM-Hub Control Plane (Centralized IAM, Dynamic Menu & Remote Config)
AUTH_PROVIDER=hub
NUXT_PUBLIC_HUB_URL=http://localhost:4000
NUXT_PUBLIC_HUB_APP_ID=tm-tools_your_app_id

# Auth Tokens (AUTH_JWT_SECRET must match AUTH_JWT_SECRET in tm-hub if AUTH_PROVIDER=hub)
AUTH_JWT_SECRET=your-shared-secret-matching-hub-auth-jwt-secret
AUTH_REFRESH_TOKEN_SECRET=your-refresh-secret-min-32-chars
AUTH_ACCESS_TOKEN_EXPIRY=900
AUTH_REFRESH_TOKEN_EXPIRY=604800

# Standalone MongoDB (Used when AUTH_PROVIDER=mongodb or for local app storage)
MONGODB_URI=mongodb://localhost:27017
MONGODB_DB_NAME=tm-tools

# Standalone Supabase (Used when AUTH_PROVIDER=supabase)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_PUBLISHABLE_KEY=your-publishable-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Cloudinary (Direct fallback if not using TM-Hub Media Gateway)
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret

# Firebase Storage / Services
FIREBASE_PROJECT_ID=your-project-id
FIREBASE_CLIENT_EMAIL=your-client-email
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
FIREBASE_STORAGE_BUCKET=your-bucket.appspot.com

# Web Push Notifications (VAPID)
WEB_PUSH_PUBLIC_KEY=your-vapid-public-key
WEB_PUSH_PRIVATE_KEY=your-vapid-private-key
WEB_PUSH_SUBJECT=mailto:admin@example.com

# Native Tools Paths (Optional overrides for binary tools; default bundled in resources/)
TOOLS_YTDLP_PATH=
TOOLS_FFMPEG_PATH=
TOOLS_FFPROBE_PATH=
TOOLS_FFPLAY_PATH=

# AI Provider Configuration (AI Chat & Tools)
AI_PROVIDER=gemini
AI_API_KEY=your-gemini-api-key
AI_BASE_URL=
AI_MODEL=gemini-2.0-flash

