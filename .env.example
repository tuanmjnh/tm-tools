# ==============================================================================
#
# TM-Tools Application Environment Configuration (.env.example)
#
# Env-key standard (v2, 2026-10-20): every app stores ONLY its own identifiers.
# Satellites never carry tm-hub's id and tm-hub never carries a satellite's id;
# child app ids are managed dynamically in the hub `apps` table by `pnpm seed`.
#
#   tm-hub       -> APP_ID
#   tm-tools     -> NUXT_PUBLIC_HUB_APP_ID  (own app id; X-App-Id sent to hub)
#   tm-trading   -> NUXT_PUBLIC_HUB_APP_ID  (own app id; X-App-Id sent to hub)
#   satellites   -> AUTH_JWT_PUBLIC_KEYS    (Hub public JWKs; preferred, not a secret)
#                -> AUTH_JWT_SECRET         (legacy HS256 fallback, migration only)
#   satellites   -> NUXT_PUBLIC_HUB_URL      (hub base URL, canonical name)
#   electron     -> HUB_DEVICE_*             (per-device credential from enrollment)
#
# Copy this file to .env and fill in values. DO NOT commit .env.
# ==============================================================================

# Application & Ports
# - dev (pnpm dev): http://localhost:4002 (PORT; fleet allocation: hub 4000,
#   trading 4001, tools 4002)
#   NOTE: `nuxt dev` reads process.env.PORT BEFORE .env is loaded, so a shell
#   that inherited PORT=3000 (or any other value) would shadow this file and
#   bind that port instead. The `pnpm dev` script pins --port 4002 on the CLI,
#   which is authoritative and cannot be shadowed by env.
# - Electron prod (pnpm dev:electron / build:electron): APP_PORT=3456 (NITRO_PORT)
PORT=4002
APP_PORT=3456
APP_URL=http://localhost:4002
APP_NAME="TM Tools"

# TM-Hub Control Plane (Centralized IAM, Dynamic Menu & Remote Config)
AUTH_PROVIDER=hub
NUXT_PUBLIC_HUB_URL=http://localhost:4000
NUXT_PUBLIC_HUB_APP_ID=tm-tools_your_app_id
# Server-to-server credential for the hub AI relay (X-App-Secret). This is for
# server runtimes (Vercel/workers) only. The Electron build does NOT use it: an
# enrolled device sends X-Device-Id/X-Device-Secret instead. `pnpm seed tools` in
# tm-hub writes the app's real secret_key here; never paste it by hand.
NUXT_HUB_APP_SECRET=

# Per-device credential (P4). Written by Settings → Hub → Enroll in the app and
# stored through safeStorage in userData/config.env — never hand-edit or commit.
# HUB_DEVICE_SECRET is a secret slot; the rest is identity metadata.
HUB_DEVICE_ID=
HUB_DEVICE_SECRET=
HUB_DEVICE_USER_ID=
HUB_DEVICE_APP_ID=
HUB_DEVICE_EXPIRES_AT=
HUB_DEVICE_SCOPES=

# Auth Tokens
# AUTH_JWT_JWKS_URL is the hub's public key endpoint. Preferred over the inline
# copy below: keys rotate on the hub without a new installer, and nothing secret
# ever travels to the desktop.
#   AUTH_JWT_JWKS_URL=https://<hub>/api/v1/auth/jwks
AUTH_JWT_JWKS_URL=
# AUTH_JWT_PUBLIC_KEYS is the JSON array of hub PUBLIC JWKs (the same document
# served at <hub>/api/v1/auth/jwks). It is not a secret, so a packaged build
# may embed it; it is how an RS256 hub token is verified when the hub is
# unreachable.
AUTH_JWT_PUBLIC_KEYS=
# Legacy HS256 fallback: only needed while the hub still issues HS256 tokens.
# Remove it once every token in circulation is RS256.
AUTH_JWT_SECRET=your-shared-secret-matching-hub-auth-jwt-secret
AUTH_REFRESH_TOKEN_SECRET=your-refresh-secret-min-32-chars
AUTH_ACCESS_TOKEN_EXPIRY=900
AUTH_REFRESH_TOKEN_EXPIRY=604800

# Standalone MongoDB (Used when AUTH_PROVIDER=mongodb or for local app storage)
MONGODB_URI=mongodb://localhost:27017
MONGODB_DB_NAME=tm-tools

# Standalone Supabase (Used when AUTH_PROVIDER=supabase)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_PUBLISHABLE_KEY=your-publishable-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Cloudinary (Direct fallback if not using TM-Hub Media Gateway)
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret

# Firebase Storage / Services
FIREBASE_PROJECT_ID=your-project-id
FIREBASE_CLIENT_EMAIL=your-client-email
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
FIREBASE_STORAGE_BUCKET=your-bucket.appspot.com

# Web Push Notifications (VAPID)
WEB_PUSH_PUBLIC_KEY=your-vapid-public-key
WEB_PUSH_PRIVATE_KEY=your-vapid-private-key
WEB_PUSH_SUBJECT=mailto:admin@example.com

# Native Tools Paths (Optional overrides for binary tools; default bundled in resources/)
TOOLS_YTDLP_PATH=
TOOLS_FFMPEG_PATH=
TOOLS_FFPROBE_PATH=
TOOLS_FFPLAY_PATH=

# AI Provider Configuration (AI Chat & Tools)
AI_PROVIDER=gemini
AI_API_KEY=your-gemini-api-key
AI_BASE_URL=
AI_MODEL=gemini-2.0-flash


# ==============================================================================
# Document Studio v4 — cloud runtime (Phases 5–8)
#
# Server-only. Nothing below may be exposed with a NUXT_PUBLIC_ prefix.
# Leave everything empty for local/Electron: those runtimes never read it.
# See docs/document-studio/VERCEL-DEPLOYMENT.md for scope per environment.
# ==============================================================================

# Runtime override: local | electron | vercel | worker (auto-detected if empty)
DOCUMENT_RUNTIME=

# PostgreSQL / Neon (server only). DATABASE_URL is pooled; the DIRECT string is
# only for running migrations.
DATABASE_URL=
DATABASE_URL_DIRECT=

# Cloudflare R2 — private bucket (server only)
R2_ACCOUNT_ID=
R2_ENDPOINT=
R2_REGION=auto
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=

# Limits and retention
DOCUMENT_PRESIGN_UPLOAD_TTL_SECONDS=600
DOCUMENT_PRESIGN_DOWNLOAD_TTL_SECONDS=300
DOCUMENT_MAX_UPLOAD_BYTES=104857600
DOCUMENT_MAX_TOTAL_JOB_BYTES=104857600
DOCUMENT_MAX_SCRATCH_BYTES=367001600
DOCUMENT_INPUT_RETENTION_HOURS=24
DOCUMENT_OUTPUT_RETENTION_HOURS=24
DOCUMENT_JOB_HISTORY_DAYS=7

# Bearer token the retention scheduler presents. Empty disables the route.
DOCUMENT_CLEANUP_TOKEN=
