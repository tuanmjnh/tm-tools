# Nuxt dev/build outputs
.output
.data
.nuxt
.nitro
.cache
.playwright-mcp
.tmp-*
.gate-*
.superpowers
scratch
dist

# Only the SFC twin that TypeScript can emit; a broad `*.js` rule would hide real
# JavaScript sources and let generated pollution accumulate unseen. Everything
# else is caught by `pnpm check:hygiene` and shows up in `git status`.
/app/**/*.vue.js

# Electron build outputs
release
dist-electron
# Generated by pnpm bake:public-config: public Hub config, environment-specific.
/resources/public-config.json

# Gate logs written by the verification commands
.gate-*.txt

# Node dependencies
node_modules

# Logs
/logs
*.log

# Misc
.DS_Store
.fleet
.idea

# Local env files
.env
.env.*
!.env.example

# VSC
.history

