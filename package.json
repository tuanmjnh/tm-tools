{
  "name": "tm-tools",
  "version": "1.0.1",
  "description": "Desktop Automation, Media Production & Multi-Profile Workspace",
  "author": "Developer",
  "private": true,
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "build": "nuxt build",
    "dev": "nuxt dev --port 4002",
    "preview": "nuxt preview",
    "postinstall": "nuxt prepare",
    "nuxt-update": "pnpm update nuxt @nuxt/ui --latest",
    "pnpm-update": "pnpm self-update",
    "lint": "eslint .",
    "typecheck": "nuxt typecheck",
    "dev:electron": "concurrently -k \"nuxt dev --port 4002\" \"wait-on http://localhost:4002 && node electron/tools/dev-electron-launcher.cjs\"",
    "test": "tsx tests/unit/run-all.mts",
    "check:hygiene": "tsx tools/check-source-hygiene.mts",
    "test:unit": "tsx tests/unit/run-all.mts",
    "build:electron:main": "esbuild electron/src/index.ts --bundle --platform=node --target=node20 --outfile=electron/dist/index.cjs --external:electron --external:better-sqlite3",
    "dereference:output": "node electron/tools/dereference-links.cjs .output",
    "copy:pdf-runtime": "node electron/tools/copy-pdf-runtime.cjs .output",
    "build:electron": "pnpm bake:public-config && pnpm build:electron:main && nuxt build && pnpm copy:pdf-runtime && pnpm dereference:output && electron-builder --win --config electron-builder.yml",
    "db:generate": "drizzle-kit generate",
    "bake:public-config": "node electron/tools/public-config.cjs"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1162.0",
