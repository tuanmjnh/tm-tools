    "@iconify-json/simple-icons": "^1.2.92",
    "@internationalized/date": "^3.12.2",
    "@nuxt/image": "^2.2.0",
    "@nuxt/ui": "^4.12.0",
    "@nuxtjs/i18n": "^10.6.0",
    "@pdf-lib/fontkit": "^1.1.1",
    "@pinia/nuxt": "^1.0.2",
    "@supabase/supabase-js": "^2.111.0",
    "@tanstack/table-core": "^8.21.3",
    "@tinymce/tinymce-vue": "^6.3.0",
    "@tiptap/core": "^3.32.0",
    "@tiptap/extension-bubble-menu": "^3.32.0",
