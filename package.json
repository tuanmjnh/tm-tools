{
  "name": "tm-tools",
  "version": "1.0.0",
  "description": "Electron + Nuxt 4 Desktop Application",
  "author": "Developer",
  "private": true,
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "build": "nuxt build",
    "dev": "nuxt dev",
    "preview": "nuxt preview",
    "postinstall": "nuxt prepare",
    "lint": "eslint .",
    "typecheck": "nuxt typecheck",
    "dev:electron": "concurrently -k \"nuxt dev\" \"wait-on http://localhost:3000 && electron .\"",
    "build:electron": "nuxt build && electron-builder --win --config electron-builder.yml",
    "seed": "npx tsx scripts/seed.ts",
    "seed:reset": "npx tsx scripts/seed.ts --reset",
    "generate:vapid": "npx tsx -e \"const wp = require('web-push'); const keys = wp.generateVAPIDKeys(); console.log(JSON.stringify(keys, null, 2))\""
  },
  "dependencies": {
    "@he-tree/vue": "2.10.1",
