{
  "name": "tm-tools",
  "version": "1.0.0",
  "description": "Desktop Application",
  "author": "Developer",
  "private": true,
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "build": "nuxt build",
    "dev": "nuxt dev",
    "preview": "nuxt preview",
    "postinstall": "nuxt prepare",
    "nuxt-update": "pnpm update nuxt @nuxt/ui --latest",
    "pnpm-update": "pnpm self-update",
    "lint": "eslint .",
    "typecheck": "nuxt typecheck",
    "dev:electron": "concurrently -k \"nuxt dev\" \"wait-on http://localhost:3000 && electron . --no-sandbox\"",
    "test:core": "node --test \"../tmcut-core/test/*.test.mjs\"",
    "test:render": "tsx --tsconfig tsconfig.test.json tests/unit/tmcut_render_graph.spec.ts",
    "test:time": "tsx --tsconfig tsconfig.test.json tests/unit/tmcut_time_domain.spec.ts",
    "test:store": "tsx --tsconfig tsconfig.test.json tests/unit/tmcut_store_behaviour.spec.ts",
    "test:templates": "tsx --tsconfig tsconfig.test.json tests/unit/tmcut_templates.spec.ts",
    "test:history": "tsx --tsconfig tsconfig.test.json tests/unit/tmcut_history.spec.ts",
    "test:save": "tsx --tsconfig tsconfig.test.json tests/unit/tmcut_save_lifecycle.spec.ts",
    "test:ripple": "tsx --tsconfig tsconfig.test.json tests/unit/tmcut_ripple.spec.ts",
    "test:markers": "tsx --tsconfig tsconfig.test.json tests/unit/tmcut_markers.spec.ts",
    "test:transitions": "tsx --tsconfig tsconfig.test.json tests/unit/tmcut_transitions.spec.ts",
    "test:split-trim": "tsx --tsconfig tsconfig.test.json tests/unit/tmcut_split_trim.spec.ts",
    "test:tmcut": "tsx tests/unit/run-all.mts",
    "test:groups": "tsx --tsconfig tsconfig.test.json tests/unit/tmcut_groups.spec.ts",
    "test:projects": "tsx --tsconfig tsconfig.test.json tests/unit/tmcut_projects_lifecycle.spec.ts",
    "test:tracks": "tsx --tsconfig tsconfig.test.json tests/unit/tmcut_tracks.spec.ts",
    "test:copy-paste": "tsx --tsconfig tsconfig.test.json tests/unit/tmcut_copy_paste.spec.ts",
    "test:recovery": "tsx --tsconfig tsconfig.test.json tests/unit/tmcut_recovery.spec.ts",
    "test:dashboard": "tsx --tsconfig tsconfig.test.json tests/unit/tmcut_dashboard.spec.ts",
    "test:ripple2": "tsx --tsconfig tsconfig.test.json tests/unit/tmcut_ripple2.spec.ts",
    "test:ai-script": "tsx --tsconfig tsconfig.test.json tests/unit/tmcut_ai_script.spec.ts",
    "test:autocut": "tsx --tsconfig tsconfig.test.json tests/unit/tmcut_autocut_v2.spec.ts",
    "test:smoke": "tsx --tsconfig tsconfig.test.json tests/unit/tmcut_render_smoke.spec.ts",
    "test:ai": "node --test electron/tools/ai-gateway.test.mjs",
    "check:core": "node ../tmcut-core/tools/check-boundaries.mjs",
    "lint:core": "cd ../tmcut-core && node ../tm-tools/node_modules/eslint/bin/eslint.js .",
    "typecheck:core": "node ../tm-tools/node_modules/typescript/lib/tsc.js --noEmit -p ../tmcut-core/tsconfig.check.json",
    "build:electron:main": "esbuild electron/src/index.ts --bundle --platform=node --target=node20 --outfile=electron/dist/index.cjs --external:electron --external:better-sqlite3",
    "build:electron": "pnpm build:electron:main && nuxt build && electron-builder --win --config electron-builder.yml",
    "db:generate": "drizzle-kit generate",
    "generate:vapid": "npx tsx -e \"const wp = require('web-push'); const keys = wp.generateVAPIDKeys(); console.log(JSON.stringify(keys, null, 2))\""
  },
  "dependencies": {
    "@he-tree/vue": "2.10.1",
