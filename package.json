    "@nuxt/image": "^2.1.0",
    "@nuxt/ui": "^4.10.0",
    "@nuxtjs/i18n": "^10.5.0",
    "@supabase/supabase-js": "^2.111.0",
    "@tanstack/table-core": "^8.21.3",
    "@tinymce/tinymce-vue": "^6.3.0",
    "@tiptap/core": "^3.29.2",
    "@tiptap/extension-bubble-menu": "^3.29.2",
    "@tiptap/extension-character-count": "^3.29.2",
    "@tiptap/extension-code-block-lowlight": "^3.29.2",
