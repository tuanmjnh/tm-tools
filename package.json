    "@types/bcryptjs": "^3.0.0",
    "@types/better-sqlite3": "^9.6.0",
    "@types/sortablejs": "^1.15.8",
    "@types/uuid": "^10.0.0",
    "@types/web-push": "^3.6.4",
    "concurrently": "^10.0.4",
    "drizzle-kit": "^0.31.10",
    "electron": "^43.2.0",
    "electron-builder": "^26.15.3",
    "eslint": "^10.8.0",
    "tsx": "^4.23.1",
    "typescript": "^6.0.3",
    "vue-tsc": "^3.3.8",
    "wait-on": "^9.1.0"
  },
  "packageManager": "pnpm@11.24.0"
}
