    "@tiptap/extension-table-header": "^3.29.2",
    "@tiptap/extension-table-row": "^3.29.2",
    "@tiptap/extension-text-align": "^3.29.2",
    "@tiptap/extension-typography": "^3.29.2",
    "@tiptap/extension-underline": "^3.29.2",
    "@tiptap/extension-youtube": "^3.29.2",
    "@tiptap/markdown": "^3.29.2",
    "@tiptap/pm": "^3.29.2",
    "@tiptap/starter-kit": "^3.29.2",
    "@tiptap/suggestion": "^3.29.2",
    "@tiptap/vue-3": "^3.29.2",
    "@unovis/ts": "^1.6.7",
    "@unovis/vue": "^1.6.7",
    "@vueuse/core": "^14.4.0",
    "@vueuse/nuxt": "^14.4.0",
    "bcryptjs": "^3.0.3",
    "better-sqlite3": "^13.0.2",
    "cloudinary": "^2.10.0",
    "date-fns": "^4.4.0",
    "drizzle-orm": "^0.45.2",
    "easyqrcodejs": "^4.6.2",
    "electron-updater": "^6.8.9",
    "firebase": "^12.17.0",
    "firebase-admin": "^14.2.0",
    "jose": "^6.2.4",
    "jsbarcode": "^3.12.3",
    "json-editor-vue": "^0.19.1",
    "mongodb": "^7.5.0",
    "nuxt": "^4.5.2",
    "pinia": "^4.0.3",
    "reka-ui": "2.10.1",
    "scule": "^1.3.0",
    "sortablejs": "^1.15.2",
    "striptags": "^3.2.0",
    "tailwindcss": "^4.3.3",
    "tm-hub-client": "^1.0.4",
    "to-px": "^1.1.0",
    "uuid": "^14.0.1",
    "vanilla-jsoneditor": "^3.13.0",
    "vue": "^3.5.40",
    "vue-draggable-resizable": "3.0.0",
    "web-push": "^3.6.7",
    "zod": "^4.4.3"
  },
  "devDependencies": {
