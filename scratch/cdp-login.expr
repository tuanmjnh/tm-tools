(async () => {
  const sleep = ms => new Promise(r => setTimeout(r, ms))
  const setValue = (el, val) => {
    const proto = Object.getPrototypeOf(el)
    const desc = Object.getOwnPropertyDescriptor(proto, 'value')
    desc.set.call(el, val)
    el.dispatchEvent(new Event('input', { bubbles: true }))
    el.dispatchEvent(new Event('change', { bubbles: true }))
  }
  if (!location.pathname.startsWith('/login')) {
    location.href = '/login'
    return { navigated: true, from: location.pathname }
  }
  await sleep(500)
  const email = document.querySelector('input[type="text"]')
  const pwd = document.querySelector('input[type="password"]')
  if (!email || !pwd) return { error: 'no inputs', html: document.body.innerText.slice(0, 300) }
  setValue(email, 'tools-root@example.com')
  await sleep(150)
  setValue(pwd, 'b15@bE&B')
  await sleep(200)
  const btn = document.querySelector('button[type="submit"]')
  if (!btn) return { error: 'no submit button' }
  btn.click()
  await sleep(4000)
  const authCookie = document.cookie.includes('accessToken')
  return { clicked: true, path: location.pathname, authCookie, text: document.body.innerText.slice(0, 200) }
})()
